{
  "name": "@tractorbeamai/quickstart",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "cf-typegen": "wrangler types --include-runtime=false",
    "clean": "rm -rf node_modules .tanstack .pnpm-store .wrangler dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:push": "pnpm db:generate && pnpm db:migrate",
    "db:seed": "tsx src/db/seed.ts",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "dev": "vp dev",
    "format": "vp fmt",
    "lint": "vp lint",
    "lint:knip": "knip",
    "check": "vp check",
    "lint:fix": "vp lint --fix",
    "preview": "vp preview",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/react": "^4.0.130",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "knip": "^6.39.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.10.1",
    "shadcn": "latest",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@tanstack/intent": "^0.5.3",
    "@tractorbeam/oxfmt-config": "^0.2.0",
    "@tractorbeam/oxlint-config": "^0.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": ">=11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/virtual-file-routes"
    ]
  }
}
