{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickstart",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickstart",
      // Local dev runs against a Miniflare copy in .wrangler/ and ignores this
      // id. Replace it with the id from `pnpm wrangler d1 create quickstart`
      // before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Workers Previews (`wrangler preview`): one per branch/PR, never touching
  // production data. All Previews share this staging database; keep its id in
  // sync with wrangler.preview-migrations.jsonc. Replace the id with the one
  // from `pnpm wrangler d1 create quickstart-preview`.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "quickstart-preview",
        "database_id": "00000000-0000-0000-0000-000000000001",
      },
    ],
  },
}
